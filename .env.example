# Copy to .env.local; keep the real file on this computer and out of Git.
# Include the API version path in BASE_URL, e.g. https://your-provider.example/v1
LEMMA_MODEL_BASE_URL=
LEMMA_MODEL=
LEMMA_MODEL_API_KEY=
# Optional: low, medium, high; empty leaves the choice to the provider.
LEMMA_MODEL_REASONING_EFFORT=
# Optional: 1000..14400000 ms; default 7200000 (2 hours).
LEMMA_MODEL_TIMEOUT_MS=
# Optional: override suggested stage output budgets; 1..393216 tokens; must fit the selected provider.
LEMMA_MODEL_MAX_OUTPUT_TOKENS=
# Optional: 32768..33554432 bytes; default 33554432.
LEMMA_MODEL_MAX_RESPONSE_BYTES=

# Optional: 1..4 concurrent model requests, default 1. Raise only after actual provider validation.
LEMMA_MODEL_CONCURRENCY=1

# Optional separate semantic reviewer. Empty values use the primary provider.
# Supplying any of the first three requires all three. Never put keys in evidence.
LEMMA_SEMANTIC_MODEL_BASE_URL=
LEMMA_SEMANTIC_MODEL=
LEMMA_SEMANTIC_MODEL_API_KEY=
LEMMA_SEMANTIC_MODEL_REASONING_EFFORT=
LEMMA_SEMANTIC_MODEL_TIMEOUT_MS=
LEMMA_SEMANTIC_MODEL_MAX_OUTPUT_TOKENS=
LEMMA_SEMANTIC_MODEL_MAX_RESPONSE_BYTES=
LEMMA_SEMANTIC_MODEL_CONCURRENCY=1
# Family names are declarations, not proof of independent errors.
LEMMA_MODEL_FAMILY=
LEMMA_SEMANTIC_MODEL_FAMILY=

# Optional local formula model. Default preserves PDF.js text/positions/page image.
# Set to docling only after installing the pinned Python environment and models.
LEMMA_DOCUMENT_PARSER=
